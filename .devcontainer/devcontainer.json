{
  "name": "Nimroz development",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/nimroz-sys",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Nimroz web application", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
